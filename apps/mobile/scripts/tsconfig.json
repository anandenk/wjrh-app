{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "../src/*"
      ]
    }
  },
  "include": [
    "../src/**/*.test.ts",
    "../src/api/client.ts",
    "../src/api/endpoints.ts",
    "../src/api/types.ts",
    "../src/config.ts",
    "../src/reminders/plan.ts",
    "../src/screens/now/now-state.ts",
    "../src/screens/schedule/schedule-state.ts",
    "../src/utils/format-time.ts",
    "globals.d.ts",
    "smoke-api.ts"
  ]
}
